DB_HOST=localhost
DB_PORT=3306
DB_NAME=ihcmdinstitute_newdb
DB_USER=ihcmdinstitute_newdb_user
DB_PASSWORD=ihcmdinstitute_newdb_user_password
DB_DIALECT=mysql

# Set this to the real production domain in .env.production.
NEXT_PUBLIC_SITE_URL=https://ihcmdinstitute.com

# Where uploaded files are physically written. Must match the Apache Alias
# For cPanel, this will be something like /home/your_username/public_html/ihcmduploads (if deploying to root)
UPLOAD_DIR=/home/ihcmdinstitute/public_html/ihcmduploads

# URL prefix uploaded files are served under. This is a path, not a full
# URL — it gets prepended to stored paths like /ihcmduploads/about/x.png,
# and the browser resolves that against the current domain automatically.
PUBLIC_MEDIA_URL=/ihcmduploads

# NextAuth (Auth.js) v5 — signs and encrypts the JWT session cookie.
# Generate a fresh one for production (e.g. using `npx auth secret`)
AUTH_SECRET=F3p54SDE4pQY/kYrpfVzXMHT1yjzxLrWjALkXZ+3Pz4=

